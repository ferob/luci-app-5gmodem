msgstr "Regisztráció elutasítva"

msgid "Data roaming is off"
msgstr "Az adatroaming ki van kapcsolva"

msgid "The update is still building on the server. Please wait about 15-20 minutes and try again."
msgstr "A frissítés még készül a szerveren. Várj körülbelül 15–20 percet, majd próbáld újra."

msgid "Modem address, not external"
msgstr "Modemcím, nem külső cím"

msgid "starting"
msgstr "indítás"

msgid "system"
msgstr "rendszer"

msgid "configuration"
msgstr "konfiguráció"

msgid "USB and ports"
msgstr "USB és portok"

