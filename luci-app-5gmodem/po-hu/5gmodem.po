msgstr "Hálózati eszköz"

msgid "No AT control port found"
msgstr "Nem található AT-vezérlőport"

msgid "No HiLink network card found to create an interface for"
msgstr "Nem található HiLink hálózati kártya, amelyhez interfészt lehetne létrehozni"

