msgstr "%d modem összesen %d mA-t igényel. Az ilyen modem válaszol az AT-parancsokra, de az interfésze nem aktiválódik — egy saját tápos USB-hub segíthet."

msgid "5G in modem"
msgstr "5G a modemben"

msgid "Enabled (SA + NSA)"
msgstr "Engedélyezve (SA + NSA)"

msgid "Only SA enabled"
msgstr "Csak az SA engedélyezett"

msgid "Only NSA enabled"
msgstr "Csak az NSA engedélyezett"

msgid "Disabled in modem"
