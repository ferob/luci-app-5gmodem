msgstr "IPv4 és IPv6 (ajánlott)"

msgid "IPv4 only"
msgstr "Csak IPv4"

msgid "IPv4+IPv6"
msgstr "IPv4+IPv6"

msgid "IPv6"
msgstr "IPv6"

